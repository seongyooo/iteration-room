# ---- Unity generated ----
# Library/ alone is ~2.7GB of regenerable import cache. Never commit these.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta files are REQUIRED - Unity tracks references by the GUID inside them.
# Never add a blanket *.meta ignore.

# ---- IDE / build artifacts ----
.vs/
.vscode/
.idea/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
sysinfo.txt

# ---- Packaged output ----
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# ---- Addressables ----
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---- This project ----
# Headless build logs from the initial project setup - regenerable, not source.
_setup_logs/
# Screenshot scratch: the MCP camera tool writes here during visual checks.
Captures/
[Aa]ssets/[Ss]creenshots/
[Aa]ssets/[Ss]creenshots.meta

# The scene is generated, not authored. SceneBuilder.Build() is the source of truth for
# every object in it, and Unity assigns fresh fileIDs to all ~1,700 of them on each rebuild -
# so a one-line change to a script produced an 11,000-line scene diff with no semantic content,
# and any merge of two rebuilds was a guaranteed conflict over noise. Run the build to get it:
#   Unity.exe -batchmode -nographics -projectPath . -executeMethod IterationRoom.EditorTools.SceneBuilder.Build -quit
# The .meta is deliberately NOT ignored: it pins the scene's GUID, which
# ProjectSettings/EditorBuildSettings.asset stores. Drop it and every clone regenerates a
# different GUID and dirties that file.
[Aa]ssets/[Ss]cenes/*.unity

# Byte-cache from the Tools/ generator scripts.
__pycache__/

# Burst drops its generated WebGL plugin at the project root during a player build.
# Build output, not source - the same category as Build/.
/Data/
